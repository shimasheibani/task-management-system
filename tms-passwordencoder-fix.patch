From c855ff9976211a400db81cda0866d43832a5e9a0 Mon Sep 17 00:00:00 2001
From: shima sheibani <shima.sheibani72@gmail.com>
Date: Fri, 24 Jul 2026 10:22:30 +0200
Subject: [PATCH] Fix ApplicationContext load failure: add missing
 PasswordEncoder bean

AuthService constructor-injects PasswordEncoder, but no bean of that type
was ever defined anywhere in the app. Spring Security's auto-configuration
does not provide one by default, so the context failed to start with
NoSuchBeanDefinitionException - surfaced as 'Failed to load
ApplicationContext' in TmsApplicationTests.contextLoads.

Added a SecurityConfig class that provides a BCryptPasswordEncoder bean.
---
 .../tms/config/SecurityConfig.java            | 21 +++++++++++++++++++
 1 file changed, 21 insertions(+)
 create mode 100644 tms/src/main/java/org/taskmanagementsystem/tms/config/SecurityConfig.java

diff --git a/tms/src/main/java/org/taskmanagementsystem/tms/config/SecurityConfig.java b/tms/src/main/java/org/taskmanagementsystem/tms/config/SecurityConfig.java
new file mode 100644
index 0000000..9ce474e
--- /dev/null
+++ b/tms/src/main/java/org/taskmanagementsystem/tms/config/SecurityConfig.java
@@ -0,0 +1,21 @@
+package org.taskmanagementsystem.tms.config;
+
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder;
+import org.springframework.security.crypto.password.PasswordEncoder;
+
+@Configuration
+public class SecurityConfig {
+
+    /**
+     * AuthService depends on PasswordEncoder, but no bean was ever defined for it
+     * anywhere in the app. Spring Security does not auto-provide one, so the
+     * application context failed to start with a NoSuchBeanDefinitionException
+     * (surfaced in tests as "Failed to load ApplicationContext").
+     */
+    @Bean
+    public PasswordEncoder passwordEncoder() {
+        return new BCryptPasswordEncoder();
+    }
+}
